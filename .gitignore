.idea/
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/

# Temporary files of the step scripts (TMPDIR): clones and checkouts, on disk rather than in /tmp.
/.tmp/

# Downloaded tools (./setup.sh fetches the pinned, sha256-verified artifacts) and the build.
/lib/
/measurer/target/

# Measured and derived data are not committed (results/ reaches many GB); their hashes are, in
# analysis-hashes.txt. labels/ is the MLCQ download and its conversion, regenerated by
# `cds mlcq-prepare` and hashed.
/results/
/labels/

# Fontana's data set and the Qualitas Corpus are fetched by scripts/fetch_fontana.sh and not
# redistributed; the sha256 of every file fetched (SHA256SUMS) and the record of where they came
# from (ACCESS.md) are committed.
/inputs/fontana/*
!/inputs/fontana/ACCESS.md
!/inputs/fontana/SHA256SUMS

# Blog drafts for blog.officefloor.net; not part of the study.
/blog/
